# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hoppscotch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hoppscotch
EXTERNAL_PORT=3300

# ==================== Brauzer manzili ====================
# VITE_* lar scripts/gen-env-urls.sh orqali .env.urls ga yoziladi (make services-up).
# PUBLIC_ORIGIN — foydalanuvchi brauzerida ko'rinadigan scheme+host+port (tarmoq/IP har xil bo'lishi mumkin).
# PUBLIC_PATH — nginx dagi subpath (masalan api-docs → /api-docs/).
PUBLIC_ORIGIN=https://agrozamin.uz
PUBLIC_PATH=api-docs

# ==================== ENCRYPTION ====================
DATA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== ACCESS ====================
ENABLE_SUBPATH_BASED_ACCESS=true
ALLOW_SECURE_COOKIES=false

WHITELISTED_ORIGINS=*

# ==================== AUTH ====================
ENABLE_AUTH=true
DISABLE_SIGNUP=false
ALLOWED_AUTH_PROVIDERS=EMAIL
VITE_ALLOWED_AUTH_PROVIDERS=EMAIL

# ==================== JWT / SESSION ====================
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== MAILER ====================
MAILER_SMTP_ENABLE=true
MAILER_USE_CUSTOM_CONFIGS=false
MAILER_ADDRESS_FROM=noreply@hoppscotch.local
MAILER_SMTP_URL=smtp://mailcatcher:1025
