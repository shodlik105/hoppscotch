# ==================== HOPPSCOTCH SELF-HOST — ENV EXAMPLE ====================
# Nusxalab .env faylini yarating: cp .env.example .env
# Qimmatli qiymatlarni o'zgartiring!

# ==================== EXTERNAL PORT (Docker) ====================
# Nginx external port (localhost:3300 yoki 80)
EXTERNAL_PORT=3300

# ==================== DATABASE ====================
# Postgres URL — Swarm postgres servisiga ulangan
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hoppscotch

# Postgres env (hoppscotch-db container uchun)
# POSTGRES_PASSWORD DATABASE_URL dagi parol bilan bir xil bo'lishi kerak
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hoppscotch

# ==================== ENCRYPTION (MAJBURIY) ====================
# Aynan 32 belgi. DB da sezuvchi ma'lumotlarni shifrlash uchun
DATA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== PUBLIC URLS ====================
# VM/LAN: 192.168.0.106 ni o'z VM IP ingizga almashtiring — tarmoqda har kim kirishi mumkin
# Lokal: localhost ishlatish mumkin
VITE_BASE_URL=http://192.168.0.106:3300
VITE_SHORTCODE_BASE_URL=http://192.168.0.106:3300
VITE_ADMIN_URL=http://192.168.0.106:3300/admin

VITE_BACKEND_GQL_URL=http://192.168.0.106:3300/backend/graphql
VITE_BACKEND_WS_URL=ws://192.168.0.106:3300/backend/graphql
VITE_BACKEND_API_URL=http://192.168.0.106:3300/backend/v1

REDIRECT_URL=http://192.168.0.106:3300
WHITELISTED_ORIGINS=*

# HTTPS bo'lsa: wss://your-domain.com/backend/graphql

# ==================== ACCESS MODE ====================
ENABLE_SUBPATH_BASED_ACCESS=true
ALLOW_SECURE_COOKIES=false

# HTTPS orqali kirilsa:
# ALLOW_SECURE_COOKIES=true

# ==================== AUTH ====================
ENABLE_AUTH=true
DISABLE_SIGNUP=false

# Qaysi providerlar: EMAIL, GOOGLE, GITHUB, MICROSOFT (vergul bilan)
ALLOWED_AUTH_PROVIDERS=EMAIL
VITE_ALLOWED_AUTH_PROVIDERS=EMAIL

# ==================== JWT / SESSION (MAJBURIY) ====================
# Generate: openssl rand -hex 32
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== MAILER (EMAIL MAGIC LINK) ====================
MAILER_SMTP_ENABLE=true

# LOKAL TEST: Mailcatcher (make services-up bilan)
MAILER_USE_CUSTOM_CONFIGS=false
MAILER_ADDRESS_FROM=noreply@hoppscotch.local
MAILER_SMTP_URL=smtp://mailcatcher:1025
# Email ko'rish: http://localhost:1080

# PRODUCTION: Real SMTP
# MAILER_USE_CUSTOM_CONFIGS=true
# MAILER_SMTP_URL=smtps://USER:PASS@smtp.yourdomain.tld:465

# ==================== OAuth (GOOGLE/GITHUB) — Ixtiyoriy ====================
# Google: https://console.cloud.google.com/apis/credentials
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=${PUBLIC_BASE_URL}/backend/v1/auth/github/callback
# GITHUB_SCOPE=user:email
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=${PUBLIC_BASE_URL}/backend/v1/auth/google/callback
