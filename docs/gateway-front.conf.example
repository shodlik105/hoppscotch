# =============================================================================
# Tashqi nginx (masalan agrozamin.uz) — Hoppscotch /api-docs/ uchun TUZATILGAN
# Upstream: ichki Swarm nginx — http://172.16.80.8:3300
# proxy_pass oxirida / QO'YMANGLAR — to'liq URI ketishi kerak.
# =============================================================================
#
# ASOSIY TUZATISH (sizdagi xato):
#   location ^~ /assets/   — O'CHIRING
#   location ^~ /images/   — O'CHIRING
#
# Sabab: subpath rejimida assetlar /api-docs/assets/, /api-docs/images/.
# Ildizdagi /assets/ ichki 3300 ga tushganda Hoppscotch "root"dan ochilgandek
# ko'rinadi va chalkashadi.
#
# ---------------------------------------------------------------------------
# location = / { return 302 ... /api-docs/; } — SHART EMAS (ko'pincha XATO)
# ---------------------------------------------------------------------------
# Agar agrozamin.uz da ildizda BOSHQA sayt (bosh sahifa, Laravel, va hokazo)
# bo'lsa — bunday redirect BUTUN saytni /api-docs/ ga yuboradi. QO'YMANGLAR.
#
# Qachon mumkin: faqat shu server_name faqat API-docs uchun bo'lsa yoki
# ildizda hech narsa bo'lmasa va siz xohlasangiz.
#
# Oddiy yechim: foydalanuvchilar to'g'ridan https://agrozamin.uz/api-docs/
# ochadi; linklar ham shu yo'lga beriladi (.env da PUBLIC_ORIGIN to'g'ri).
# =============================================================================

# --- http {} ichida (WebSocket uchun Connection sarlavhasi) ---
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

#     # Eski /admin → subpath (loop bo'lmasin: faqat aniq /admin)
#     location = /admin {
#         return 302 $scheme://$http_host/api-docs/admin/;
#     }
#
#     # Bitta blok ham yetarli: /api-docs/admin/, /api-docs/mailcatcher/, backend, assetlar
#     location ^~ /api-docs/ {
#         proxy_pass http://172.16.80.8:3300;
#         proxy_http_version 1.1;
#         proxy_set_header Host $http_host;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header X-Forwarded-Host $http_host;
#         proxy_set_header X-Forwarded-Port 443;
#         proxy_set_header Upgrade $http_upgrade;
#         proxy_set_header Connection $connection_upgrade;
#         proxy_read_timeout 600s;
#         proxy_send_timeout 600s;
#     }
#
# =============================================================================
# Alohida mailcatcher/admin bloklari SHART EMAS — hammasi /api-docs/ ostida.
# Agar baribir ajratmoqchi bo'lsangiz, proxy_pass va sarlavhalar xuddi shunday.
# "Connection \"upgrade\"" o'rniga yuqoridagi map + $connection_upgrade yaxshiroq
# (oddiy GET da Connection: close bo'ladi).
# =============================================================================
