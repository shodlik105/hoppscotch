# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:hH8uZ0uT0mS3yK8g@postgres:5432/hoppscotch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hH8uZ0uT0mS3yK8g
POSTGRES_DB=hoppscotch

# Sizda tashqi port endi gateway orqali 7000, lekin hoppscotch container uchun bu shart emas.
# Qoldirish mumkin (zarari yo'q). Xohlasangiz 7000 qilib ham qo'yishingiz mumkin.
EXTERNAL_PORT=3300

# ==================== ENCRYPTION (MUHIM!) ====================
# AYNAN 32 ta belgi. O'ZGARTIRMAYSIZ.
DATA_ENCRYPTION_KEY=d4FyH5xGHKmGRYBSLTc20MEMSCWwHMpF

# ==================== ACCESS MODE ====================
ENABLE_SUBPATH_BASED_ACCESS=true
ALLOW_SECURE_COOKIES=false

# ==================== PUBLIC URLS (GATEWAY: 7000 + /hoppscotch) ====================
VITE_BASE_URL=http://172.16.80.8:7000/hoppscotch
VITE_SHORTCODE_BASE_URL=http://172.16.80.8:7000/hoppscotch
VITE_ADMIN_URL=http://172.16.80.8:7000/hoppscotch/admin

VITE_BACKEND_GQL_URL=http://172.16.80.8:7000/hoppscotch/backend/graphql
VITE_BACKEND_WS_URL=ws://172.16.80.8:7000/hoppscotch/backend/graphql
VITE_BACKEND_API_URL=http://172.16.80.8:7000/hoppscotch/backend/v1

# Agar proxyscotch ishlatsangiz (hozir comment qoldiraman)
# VITE_PROXY_URL=http://172.16.80.8:7000/hoppscotch/proxy

REDIRECT_URL=http://172.16.80.8:7000/hoppscotch

# ORIGIN whitelist — root ham, subpath ham (ko'p muammolarni oldini oladi)
WHITELISTED_ORIGINS=http://172.16.80.8:7000,http://172.16.80.8:7000/hoppscotch,http://127.0.0.1:7000,http://localhost:7000

# ==================== AUTH ====================
ENABLE_AUTH=true
DISABLE_SIGNUP=true

# EMAIL provider
ALLOWED_AUTH_PROVIDERS=EMAIL
VITE_ALLOWED_AUTH_PROVIDERS=EMAIL
# Magic linklar Mailcatcher’da ko'rinadi (Mailcatcher o'zi alohida):
# http://172.16.80.8:1080

# ==================== JWT / SESSION ====================
JWT_SECRET=4bc1c17710951897e371192941d16c152c358c4c574cf513af7fc25cff20c60a
SESSION_SECRET=469aa3df09b0c812e7c419c923f4a3a5ecdbf2ac0031a22ee6cf280a5e85ecfc

# ==================== MAILER (EMAIL MAGIC LINK) ====================
MAILER_SMTP_ENABLE=true
MAILER_USE_CUSTOM_CONFIGS=false
MAILER_ADDRESS_FROM=noreply@hoppscotch.local
MAILER_SMTP_URL=smtp://postfix:587

# Production uchun smtps (qayta yoqing):
# MAILER_USE_CUSTOM_CONFIGS=true
